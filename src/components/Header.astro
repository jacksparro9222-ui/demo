---
import logo from "../assets/brand/wordmark.webp";
import { Image } from "astro:assets";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = [
  { href: "/about", label: "About" },
  { href: "/businesses", label: "Businesses" },
  { href: "/leadership", label: "Leadership" },
  { href: "/sustainability", label: "Sustainability" },
  { href: "/news", label: "News" },
  { href: "/careers", label: "Careers" },
  { href: "/contact", label: "Contact" },
];

function current(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <Image src={logo} alt="" widths={[160, 320]} sizes="148px" />
      <span class="brand-text">
        <strong>The House of Dempo</strong>
        <span>Panaji, Goa</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span></span>
    </button>
    <nav id="site-nav" class="nav-panel" data-nav-panel aria-label="Primary">
      <ul class="nav-list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

