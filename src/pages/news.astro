---
import Base from "../layouts/Base.astro";
import { stories, podcasts } from "../data/news";
---

<Base
  title="News"
  description="A selection of Dempo Group reports from dempos.com, with dates and summaries taken from the articles, plus the Insights of Masters and Brand Magic programmes."
>
  <section class="section">
    <div class="wrap" data-reveal>
      <span class="kicker">News</span>
      <h1 class="h-display-news">From the Group’s own pages.</h1>
      <p class="lede" style="margin-top: 1rem">
        These are reports published on dempos.com, chosen from the 733-post archive after
        a cross-check of that crawl. Summaries stay inside what each article says. This
        concept carries a recent selection, not a copy of every post.
      </p>
      <div class="news-list">
        {
          stories.map((story) => (
            <article>
              <p class="meta">
                <time datetime={story.iso}>{story.date}</time> · {story.category}
              </p>
              <h2>{story.title}</h2>
              <p>{story.summary}</p>
              <a href={story.source}>Read the original</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap two" data-reveal>
      <div>
        <span class="kicker">Navhind programmes</span>
        <h2 class="quote h-quote-md">{podcasts.insights.title}</h2>
        <ul class="timeline">
          {
            podcasts.insights.episodes.map((episode) => (
              <li>
                <time>{episode.date}</time>
                <p>{episode.title}</p>
              </li>
            ))
          }
        </ul>
        <p><a href={podcasts.insights.source}>Series page</a></p>
      </div>
      <div>
        <span class="kicker">Navhind programmes</span>
        <h2 class="quote h-quote-md">{podcasts.brandMagic.title}</h2>
        <ul class="timeline">
          {
            podcasts.brandMagic.episodes.map((episode) => (
              <li>
                <time>{episode.date}</time>
                <p>{episode.title}</p>
              </li>
            ))
          }
        </ul>
        <p><a href={podcasts.brandMagic.source}>Series page</a></p>
      </div>
    </div>
  </section>
</Base>
